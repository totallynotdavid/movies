{
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "predev": "bun scripts/setup.ts",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "lint": "vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt",
    "db:migrate": "vp exec void db migrate",
    "db:migrate:remote": "vp exec void db migrate --remote",
    "db:seed": "vp exec void db seed",
    "fixtures:fetch": "bun --env-file .env.local scripts/fetch-metadata.ts --all",
    "fixtures:trending": "bun --env-file .env.local scripts/fetch-metadata.ts --trending",
    "release": "vp check && vp exec void db migrate --remote && vp exec void deploy",
    "recover": "vp exec void db migrate --remote && vp exec void db seed && vp exec void deploy",
    "postinstall": "vp config"
  },
  "dependencies": {
    "@void/vue": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "valibot": "^1.4.1",
    "void": "^0.9.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.5.0",
    "@iconify-json/lucide": "^1.2.110",
    "@types/bun": "^1.3.14",
    "eslint-plugin-regexp": "3.1.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.0",
    "vite-plus": "^0.1.23",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.23",
    "wrangler": "^4.95.0"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@cloudflare/vite-plugin@1.39.0": "patches/@cloudflare%2Fvite-plugin@1.39.0.patch",
    "@better-auth/kysely-adapter@1.6.12": "patches/@better-auth%2Fkysely-adapter@1.6.12.patch"
  }
}
