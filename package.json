{
  "type": "module",
  "scripts": {
    "postinstall": "vp config",
    "typegen": "vp exec void prepare",
    "lint": "bun run typegen && vp lint --deny-warnings && vp fmt --check",
    "fix": "bun run typegen && vp lint --fix --deny-warnings && vp fmt",
    "typecheck": "bun run typegen && vp check --no-fmt --no-lint",
    "test": "bun run typegen && vp test",
    "build": "bun run typegen && vp build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "bun run setup && vp dev",
    "setup": "bun scripts/setup.ts",
    "preview": "vp preview",
    "db:migrate": "vp exec void db migrate",
    "db:migrate:remote": "vp exec void db migrate --remote",
    "db:seed": "vp exec void db seed",
    "fixtures:fetch": "bun --env-file .env scripts/fetch-metadata.ts --all",
    "fixtures:trending": "bun --env-file .env scripts/fetch-metadata.ts --trending",
    "deploy": "vp exec void deploy",
    "release": "bun run check && bun run db:migrate:remote && bun run deploy",
    "recover": "bun run db:migrate:remote && bun run db:seed && bun run deploy",
    "audit": "vp dlx fallow audit --format pr-comment-github --quiet"
  },
  "dependencies": {
    "@void/vue": "^1.1.12",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "valibot": "^1.5.0",
    "void": "^1.1.12",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@iconify-json/lucide": "^1.2.147",
    "@types/bun": "^1.4.3",
    "eslint-plugin-regexp": "3.3.1",
    "typescript": "^7.0.2",
    "unocss": "^66.11.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "@cloudflare/vite-plugin@1.64.0": "patches/@cloudflare%2Fvite-plugin@1.64.0.patch"
  }
}
