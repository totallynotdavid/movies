{
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "predev": "bun scripts/setup.ts",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "lint": "vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt",
    "db:migrate": "vp exec void db migrate",
    "db:migrate:remote": "vp exec void db migrate --remote",
    "db:seed": "vp exec void db seed",
    "fixtures:fetch": "bun --env-file .env scripts/fetch-metadata.ts --all",
    "fixtures:trending": "bun --env-file .env scripts/fetch-metadata.ts --trending",
    "release": "vp check && vp exec void db migrate --remote && vp exec void deploy",
    "recover": "vp exec void db migrate --remote && vp exec void db seed && vp exec void deploy",
    "postinstall": "vp config"
  },
  "dependencies": {
    "@void/vue": "^0.21.9",
    "drizzle-orm": "^0.45.2",
    "valibot": "^1.5.0",
    "void": "^0.21.9",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@iconify-json/lucide": "^1.2.136",
    "@types/bun": "^1.4.2",
    "eslint-plugin-regexp": "3.3.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite-plus": "0.2.4",
    "vitest": "4.1.10",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@cloudflare/vite-plugin@1.54.7": "patches/@cloudflare%2Fvite-plugin@1.54.7.patch"
  }
}
