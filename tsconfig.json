{
  "extends": "./.void/tsconfig.json",
  "files": ["./.void/db.d.ts"],
  "compilerOptions": {
    "types": ["void/env"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "pages/**/*.ts",
    "pages/**/*.vue",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "db/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "env.ts"
  ],
  "exclude": ["scripts"]
}
